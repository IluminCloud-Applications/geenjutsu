{
  "name": "geenjutsu",
  "version": "1.0.0",
  "description": "Geenjutsu - Advanced Anti-Detect Browser Studio",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json && node scripts/copy-worker.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux deb --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "antidetect",
    "browser",
    "geenjutsu",
    "fingerprint",
    "electron",
    "react"
  ],
  "author": "Geenjutsu",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^0.14.7"
  },
  "dependencies": {
    "camoufox-js": "^0.12.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^5.0.0",
    "playwright-core": "^1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remixicon": "^4.9.1",
    "socks": "^2.8.10",
    "tailwind-merge": "^3.7.0"
  }
}
